# Template file for 'fs-uae-launcher'
pkgname=fs-uae-launcher
version=3.2.35
revision=1
archs="x86_64 aarch64"
python_version=3
wrksrc="${pkgname}-${version}"

build_style=gnu-makefile
hostmakedepends="gettext python3-setuptools"
depends="
 fs-uae
 python3
 python3-pyqt6
 python3-pyqt6-gui
 python3-pyqt6-widgets
 python3-PyOpenGL
 python3-Pillow
 python3-requests
 python3-typing_extensions
 python3-lhafile
"

short_desc="Graphical frontend and launcher for FS-UAE"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="https://github.com/FrodeSolheim/fs-uae-launcher"
distfiles="https://github.com/FrodeSolheim/fs-uae-launcher/archive/v${version}/${pkgname}-${version}.tar.gz"
checksum="ed48cbc1c4a63af9c3bf45eb97271ef0ded7a67e5acaf862100ffe9e18748a77"

do_build() {
    python3 setup.py build
    make
}

do_install() {
    make install DESTDIR="${DESTDIR}" prefix=/usr
}
