# Template file for electron42-bin
pkgname=electron42-bin
version=42.11.18
revision=1
archs="x86_64 aarch64"

_desc="Electron 42 runtime built with web technologies (prebuilt)"
short_desc="${_desc}"
maintainer="Orphaned <orphan@voidlinux.org>"
license="MIT"
homepage="https://electronjs.org"

depends="alsa-lib gtk+3 nss"
hostmakedepends="unzip"

case "$XBPS_TARGET_MACHINE" in
    x86_64*)
        _electron_arch="x64"
        _checksum_electron="c703693e5df41a413dd0464888bbabc8537a7000fb6d6e4f027fea0e90481a96"
        _checksum_chromedriver="37977f55379613baed1275d9be9bbd325686643450ace265ebd91a0dc20ea6f1"
        ;;
    aarch64*)
        _electron_arch="arm64"
        _checksum_electron="7a2325a068b39271166bc93e21996047fd82e207e603ca37fe8350347851908e"
        _checksum_chromedriver="8f17afed5c1b69a48e767d868e0282f5c57d0c3fcc946fd0d98a126b52b8fc5a"
        ;;
    *)
        broken="Unsupported architecture: ${XBPS_TARGET_MACHINE}"
        ;;
esac

_electron_zip="electron-v${version}-linux-${_electron_arch}.zip"
_chromedriver_zip="chromedriver-v${version}-linux-${_electron_arch}.zip"

distfiles="
 https://github.com/electron/electron/releases/download/v${version}/${_electron_zip}
 https://github.com/electron/electron/releases/download/v${version}/${_chromedriver_zip}
"

checksum="
 ${_checksum_electron}
 ${_checksum_chromedriver}
"

skip_extraction="${_electron_zip} ${_chromedriver_zip}"

do_extract() {
    mkdir -p "${wrksrc}/electron42"

    unzip -q "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_electron_zip}" \
        -d "${wrksrc}/electron42"

    unzip -q "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_chromedriver_zip}" \
        -d "${wrksrc}/electron42"
}

do_install() {
    vmkdir usr/lib/electron42
    vcopy "${wrksrc}/electron42/." usr/lib/electron42

    vmkdir usr/bin
    vinstall "${FILESDIR}/electron42" 0755 usr/bin

    if [ -f "${DESTDIR}/usr/lib/electron42/chrome-sandbox" ]; then
        chmod 4755 "${DESTDIR}/usr/lib/electron42/chrome-sandbox"
    fi

    vmkdir usr/share/licenses/${pkgname}
    vlicense "${wrksrc}/electron42/LICENSE" LICENSE
}
