do_install() {
    vbin bin/dissent

    vinstall share/applications/so.libdb.dissent.desktop 644 \
        usr/share/applications

    vinstall share/dbus-1/services/so.libdb.dissent.service 644 \
        usr/share/dbus-1/services

    vinstall share/icons/symbolic/apps/so.libdb.dissent-symbolic.svg 644 \
        usr/share/icons/symbolic/apps

    vinstall share/icons/hicolor/scalable/apps/so.libdb.dissent.svg 644 \
        usr/share/icons/hicolor/scalable/apps

    vinstall share/icons/hicolor/scalable/apps/so.libdb.dissent.Devel.svg 644 \
        usr/share/icons/hicolor/scalable/apps
}
